{
  "expo": {
    "name": "健康家計簿",
    "slug": "FitnessTrackerApp",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/fitness-tracker-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/fitness-tracker-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#007AFF"
    },
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "15.1",
      "requireFullScreen": true,
      "icon": "./assets/images/fitness-tracker-icon.png",
      "buildNumber": "1.1.1",
      "bundleIdentifier": "com.masahirotakata.FitnessTrackerApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "newArchitecture": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.masahirotakata.FitnessTrackerApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2539444380195825~6822931393",
          "iosAppId": "ca-app-pub-2539444380195825~6822931393"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40c22857-9d45-43be-9fa5-25ac10b65d92"
      }
    }
  }
}
